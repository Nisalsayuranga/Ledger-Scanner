# Safe Public Variables for Frontend Client
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Note: Gemini API keys (GEMINI_KEY_1 to GEMINI_KEY_5) are server-side secrets.
# Set them via Supabase Secrets CLI:
# supabase secrets set GEMINI_KEY_1=your_key_1 GEMINI_KEY_2=your_key_2 GEMINI_KEY_3=your_key_3 GEMINI_KEY_4=your_key_4 GEMINI_KEY_5=your_key_5
